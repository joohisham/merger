# Turso (libsql HTTP serverless database)
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Backwards-compat aliases (optional)
TURSO_DB_URL=libsql://your-db.turso.io
TURSO_DB_TOKEN=your-turso-auth-token

# kie.ai provider base URL (default https://api.kie.ai)
KIE_BASE_URL=https://api.kie.ai

# kie.ai API key — auto-seeded into the DB on first cold start if set.
# You can also add more keys via the dashboard's "Keys" tab.
KIE_API_KEY=your-kie-ai-api-key

# External video merger microservice base URL
MERGER_BASE_URL=https://your-merger-service.example.com

# Password protection for the dashboard + /api + /mcp routes.
# If set, all routes require auth:
#   - Browser: redirected to /login, enter this password.
#   - API/MCP clients: send header "x-site-password: <value>" OR
#     "Authorization: Bearer <value>".
# If empty or missing, the site is fully open (no protection).
SITE_PASSWORD=choose-a-strong-password
